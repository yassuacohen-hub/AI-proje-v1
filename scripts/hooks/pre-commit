#!/bin/sh
# PANEL-DURUSTLUK-01 mandallari. Kurulum (bir kez):
#   git config core.hooksPath scripts/hooks
#
# .git/hooks surumlenmez; oradaki kanca klonda kaybolur. Bu dosya depoda
# durur, herkeste ayni davranir. Acil durumda: git commit --no-verify
set -e
# Kilit zorlamasi once: baskasinin dosyasini commit'lemek testten once durur
# (D-261: zorlayani olmayan kayit beyandir).
python scripts/kilit_zorla.py
# MANDAL-SAHNE-01 (D-301): toplu sahneleme kapisi. BURAYA yazilmasinin sebebi
# olculdu: kapiyi once yalniz `.pre-commit-config.yaml`a yazmistim, ama fiilen
# kosan kanca bu dosya (`core.hooksPath=scripts/hooks`) ve `pre_commit` moduLu
# kurulu degil -- yani kapi yaziliydi, KOSMUYORDU. Kanit: `8a25798` commit'i
# 24 dosyayla kapidan gecti ve benim dort mandalimi da icine aldi (D-260).
python scripts/sahne_kapisi.py
echo "[pre-commit] panel durustluk mandallari..."
# Goc defteri de burada: sema degisikligi commit'e tek basina giremesin
# (D-251/3). Karar numarasi tekligi de eklendi (D-287): yaris iki kez oldu,
# gonullu koruma koruma degildir (D-261) — mandal 0.7 sn, yeni altyapi yok.
# MANDAL-SABLON-01 (D-303): veri yazma kapisi. Olcum: 2666 kayitta sablon web,
# hepsi tek kaynaktan; kok sebep kanonik liste yoklugu (23 dosyada kopya).
# MANDAL-TAHSIS-01 (D-303): kancalarin KENDISI kosuyor mu. Bu mandal listede
# olmadan yazilmisti -- yani "kapi yazili ama kosmuyor" hatasini tam olarak
# tekrarliyordu (D-302). Kendi kuralini kendine uygula.
# Besli birlikte ~16 sn; tam takim (~170 sn) kancaya konmaz.
python -m pytest tests/test_panel_durustluk.py tests/test_goc_defteri.py tests/test_karar_numara_tekligi.py tests/test_yazma_kapisi.py tests/test_sahne_kapisi_kurulu.py -q
