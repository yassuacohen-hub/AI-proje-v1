{
    "editor.experimentalGpuAcceleration": "off",
    "claudeCode.useTerminal": true,
    "workbench.editor.enablePreview": true,
    "workbench.editor.enablePreviewFromQuickOpen": true,
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 8,
    "workbench.editor.limit.perEditorGroup": true,
    "workbench.editor.closeOnFileDelete": true,
    "files.autoRevealInExplorer": "off",
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "terminal.integrated.shellIntegration.enabled": false,
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.scrollback": 2000,
    "python.analysis.extraPaths": ["Huginn Data Insights/src"],
    "python.defaultInterpreterPath": "${workspaceFolder}/Huginn Data Insights/.venv/Scripts/python.exe",
    "terminal.integrated.env.windows": {
        "HUGINN_AJAN": "ihsan"
    },
    "chat.tools.terminal.autoApprove": {
        "/\\b(set\\s+\\w*env|\\$env:|setx|\\.env\\b|export\\s+\\w+=|git\\s+config\\s+.*(token|password|key)|secret)/i": {
            "approve": false,
            "matchCommandLine": true
        },
        "/\\b(rm\\s+-rf|del\\s+\\/s|rmdir\\s+\\/s|format\\s|DROP\\s+(TABLE|DATABASE)|git\\s+push\\s+.*--force|git\\s+reset\\s+--hard|shutdown|taskkill\\s+\\/f)/i": {
            "approve": false,
            "matchCommandLine": true
        },
        "/.*/": {
            "approve": true,
            "matchCommandLine": true
        }
    },
    "openDesign.activeDesignSystemId": "claude",
    "github.copilot.chat.customOaiModels": [
        {
            "name": "9Router - Yasu-9Router",
            "url": "http://localhost:20128/v1",
            "model": "yasu-9router",
            "apiKey": "${env:NINEROUTER_KEY}",
            "toolCalling": true,
            "vision": false
        },
        {
            "name": "9Router - Claude-ClaudeCombo",
            "url": "http://localhost:20128/v1",
            "model": "claude-claudecombo",
            "apiKey": "${env:NINEROUTER_KEY}",
            "toolCalling": true,
            "vision": false
        },
        {
            "name": "9Router - Claude Sadece",
            "url": "http://localhost:20128/v1",
            "model": "claude_sadece",
            "apiKey": "${env:NINEROUTER_KEY}",
            "toolCalling": true,
            "vision": false
        },
        {
            "name": "9Router - Full Claude",
            "url": "http://localhost:20128/v1",
            "model": "fullclaude",
            "apiKey": "${env:NINEROUTER_KEY}",
            "toolCalling": true,
            "vision": false
        },
        {
            "name": "9Router - Mimir-Dis",
            "url": "http://localhost:20128/v1",
            "model": "mimir-dis",
            "apiKey": "${env:NINEROUTER_KEY}",
            "toolCalling": true,
            "vision": false
        }
    ]
}
