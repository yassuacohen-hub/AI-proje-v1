     "izinli_gecis": ["olmadan cagirmali", "olmamali (statik)", "kaldi", "kapsamindaki"]},
    {"id": "SHELL-TRUE", "regex": "shell\\s*=\\s*True",
     "siddet": "yuksek", "aciklama": "shell=True komut enjeksiyonuna acik.",
     "izinli_gecis": []},
    {"id": "OS-SYSTEM", "regex": "os\\.system\\s*\\(",
     "siddet": "yuksek", "aciklama": "os.system kullanimi (shell enjeksiyonu).",
     "izinli_gecis": []},
    {"id": "EVAL-EXEC", "regex": "(?<![A-Za-z0-9_.])eval\\s*\\(|(?<![A-Za-z0-9_.])exec\\s*\\(",
     "siddet": "kritik", "aciklama": "Dinamik kod calistirma (eval/exec).",
     "izinli_gecis": ["exec (EXPLAIN", "DB exec", "execfile", "retrieval", "interval", "evaluation", "evaluates", "eval(repr", "are familiar with"]},
    {"id": "PICKLE-LOADS", "regex": "pickle\\.loads?\\s*\\(",
