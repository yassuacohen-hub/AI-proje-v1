    {"id": "HARDCODED-SECRET", "regex": "(?i)(password|passwd|secret_key)\\s*=\\s*[\"'][^\"']{8,}[\"']",
     "siddet": "yuksek", "aciklama": "Koda gomulu parola/secret suphesi.",
     "izinli_gecis": ["your-secure-secret", "change-this", "test-anahtar", "gercek-anahtar", "yanlis", "secret123", "EXA_API_KEY=", "API_KEY =", "api_key=", "API_KEY ?"]},
    {"id": "YAML-UNSAFE-LOAD", "regex": "yaml\\.load\\s*\\(",
     "siddet": "yuksek", "aciklama": "yaml.load Loader'siz (safe_load kullan).",
     "izinli_gecis": ["safe_load", "SafeLoader", "CSafeLoader"]}
  ]
