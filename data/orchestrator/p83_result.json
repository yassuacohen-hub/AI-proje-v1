  ],
  "ozet": "Büyüme sinyali skorlama motoru tasarımı, implementasyonu ve örnek veri ile testi tamamlandı. Beş sinyal (ilan artış hızı, yeni şehir, yeni departman, yönetici işe alımı, satış ekip genişlemesi) için skorlama motoru geliştirildi. Skorlama formülü, eşik değerleri ve negatif trend decay mekanizması tanımlandı. company_signals tablosuna growth skoru yazar; company_intelligence_scores.growth_score alanını doldurur.",
  "design": {
    "motor_tanimi": "İş ilanı (job_postings) verilerinden büyüme sinyalleri tespit eden, her sinyale 0-100 skor ve confidence atayan, ağırlıklı ortalama ile growth_score üreten motor.",
    "hedef_tablo": "company_intelligence_scores.growth_score (0-100)",
    "yazilan_tablo": "company_signals (signal_type, signal_subtype, score, confidence, evidence)",
    "formula": "growth_score = sum(sub_score_i * confidence_i * weight_i) / sum(confidence_i * weight_i), clamped [0, 100]",
    "negatif_trend_kurali": "Hiring trend negatifse (growth_rate < 0): growth_score * (1 + growth_rate/100). Clamped [0, 100]."
  },
  "signals": [
    {
      "signal_type": "growth",
      "signal_subtype": "hiring_surge",
      "weight": 0.3,
      "description": "İş ilanı artış hızı (aylık %)",
      "eses": "current_posting_count vs previous_posting_count",
      "scoring": [
        {
          "threshold": ">= 50% increase",
          "score": 100,
          "label": ">=50pct_increase"
        },
        {
          "threshold": "20-49% increase",
          "score": 80,
          "label": "20-49pct_increase"
        },
        {
          "threshold": "10-19% increase",
          "score": 60,
          "label": "10-19pct_increase"
        },
        {
          "threshold": "0-9% increase",
          "score": 40,
          "label": "0-9pct_increase"
        },
        {
          "threshold": "< 0% decline",
          "score": "40 * (1 + rate/100), clamped [0,39]",
          "label": "<0pct_decline"
        }
      ],
      "confidence_formula": "min(100, max(10, current_count * 10)); first_hiring oldugunda current_count * 20",
      "hiring_trend_kaplama": ">= 50%: accelerating, >= 10% < 50%: stable, -10%..0%: decelerating, < -10%: contracting"
    },
    {
      "signal_type": "geo_expansion",
      "signal_subtype": "new_location",
      "weight": 0.15,
      "description": "Yeni şehir/lokasyon açılışı sinyali",
      "eses": "current_month cities - historical_cities",
      "scoring": [
        {
          "threshold": "3+ yeni şehir",
          "score": 100,
          "label": "3+_new_cities"
        },
        {
          "threshold": "2 yeni şehir",
          "score": 90,
          "label": "2_new_cities"
        },
        {
          "threshold": "1 yeni şehir",
          "score": 80,
          "label": "1_new_city"
        },
        {
          "threshold": "0 yeni şehir",
          "score": 0,
          "label": "no_new_locations"
        }
      ],
      "confidence_formula": "100 if >= 2 postings in new city, else 70"
    },
    {
      "signal_type": "org_change",
      "signal_subtype": "new_department",
      "weight": 0.1,
      "description": "Yeni departman oluşumu sinyali",
      "eses": "current_month departments - historical_departments",
      "scoring": [
        {
          "threshold": "3+ yeni departman",
          "score": 100,
          "label": "3+_new_departments"
        },
        {
          "threshold": "2 yeni departman",
          "score": 90,
          "label": "2_new_departments"
        },
        {
          "threshold": "1 yeni departman",
          "score": 80,
          "label": "1_new_department"
        },
        {
          "threshold": "0 yeni departman",
          "score": 0,
          "label": "no_new_departments"
        }
      ],
      "confidence_formula": "min(100, new_dept_count * 40 + 20)"
    },
    {
      "signal_type": "investment",
      "signal_subtype": "executive_hire",
      "weight": 0.25,
      "description": "Yönetici/kadro işe alımı sinyali (director, c-level, vp, head, manager, lead)",
      "eses": "job_postings.seniority_level in EXECUTIVE_LEVELS",
      "scoring": [
        {
          "threshold": "3+ yönetici",
          "score": 100,
          "label": "3+_executive_hires"
        },
        {
          "threshold": "2 yönetici",
          "score": 85,
          "label": "2_executive_hires"
        },
        {
          "threshold": "1 yönetici",
          "score": 60,
          "label": "1_executive_hire"
        },
        {
          "threshold": "0 yönetici",
          "score": 0,
          "label": "no_executive_hires"
        }
      ],
      "confidence_formula": "100 (seniority_level data explicit)"
    },
    {
      "signal_type": "tech_transformation",
      "signal_subtype": "sales_expansion",
      "weight": 0.2,
      "description": "Satış ekip genişlemesi sinyali (Sales, BD, Account Manager, Revenue, Channel, Partner)",
      "eses": "job_postings.title veya department keyword match",
      "scoring": [
        {
          "threshold": "6+ satış",
          "score": 100,
          "label": "6+_sales_hires"
        },
        {
          "threshold": "3-5 satış",
          "score": 75,
          "label": "3-5_sales_hires"
        },
        {
          "threshold": "1-2 satış",
          "score": 50,
          "label": "1-2_sales_hires"
        },
        {
          "threshold": "0 satış",
          "score": 0,
          "label": "no_sales_hires"
        }
      ],
      "confidence_formula": "min(100, sales_count * 25 + 50)"
    }
  ],
  "weights_total": 1.0,
  "db_integration": {
