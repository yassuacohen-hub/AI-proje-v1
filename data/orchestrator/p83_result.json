{
  "task_id": "P8-3",
  "baslik": "İş ilanı takip motoru: büyüme sinyali skorlama motoru",
  "sahip": "arastirmaci",
  "oncelik": "P1",
  "durum": "done",
  "baslangic": "2026-09-09T15:47:15",
  "bitis": "2026-09-09T23:13:00",
  "dosyalar": [
    "scripts/growth_signal_scorer.py",
