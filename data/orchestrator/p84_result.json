{
  "task_id": "P8-4",
  "baslik": "İş ilanı takip motoru: risk sinyali skorlama motoru",
  "sahip": "arastirmaci",
  "oncelik": "P1",
  "durum": "done",
  "baslangic": "2026-09-09T15:47:15",
  "bitis": "2026-09-09T23:20:00",
  "dosyalar": [
    "scripts/risk_signal_scorer.py",
    "data/orchestrator/p84_result.json"
  ],
  "ozet": "Risk sinyali skorlama motoru tasarımı, implementasyonu ve örnek veri ile testi tamamlandı. Dört risk sinyali (ilan azalması, lokasyon kapanışları, teknik ekip durması, pozisyon tekrarı) için skorlama motoru geliştirildi. Skorlama formülü, eşik değerleri ve confidence mekanizması tanımlandı. company_signals tablosuna risk skoru yazar; company_intelligence_scores.risk_score alanını doldurur. Yüksek skor = düşük risk (güvenli), düşük skor = yüksek risk.",
  "design": {
    "motor_tanimi": "İş ilanı (job_postings) verilerinden risk sinyalleri tespit eden, her sinyale 0-100 skor ve confidence atayan, ağırlıklı ortalama ile risk_score üreten motor. Yüksek skor = düşük risk (güvenli), düşük skor = yüksek risk.",
    "hedef_tablo": "company_intelligence_scores.risk_score (0-100)",
    "yazilan_tablo": "company_signals (signal_type='risk', signal_subtype, score, confidence, evidence)",
    "formula": "risk_score = sum(safe_score_i * confidence_i * weight_i) / sum(confidence_i * weight_i), clamped [0, 100]",
    "negatif_trend_kurali": "Negatif sinyaller doğrudan düşük skora yansır. posting_decline için threshold-based scaling; location_closure için binary (kapanış varsa 0-25, yoksa 100); tech_team_halt için oransal azalma scaling; position_repetition için tekrar sayısı scaling."
  },
  "signals": [
    {
      "signal_type": "risk",
      "signal_subtype": "posting_decline",
      "weight": 0.35,
      "description": "İlan azalması / churn sinyali (aylık ilan sayısı düşüşü)",
      "evidence": "current_posting_count vs previous_posting_count",
      "scoring": [
        {
          "threshold": ">= 50% decline",
          "score": 5,
          "label": "critical_decline"
        },
        {
          "threshold": "20-49% decline",
          "score": 30,
          "label": "high_decline"
        },
        {
          "threshold": "10-19% decline",
          "score": 55,
          "label": "moderate_decline"
        },
        {
          "threshold": "0-9% decline",
          "score": 80,
          "label": "slight_decline"
        },
        {
          "threshold": "> 0% growth",
          "score": 100,
          "label": "growing"
        }
      ],
      "confidence_formula": "min(100, max(10, current_count * 10)); first_hiring oldugunda current_count * 20",
      "hiring_trend_kapsama": ">= 50%: contracting, >= 20% < 50%: shrinking, >= 10% < 20%: decelerating, -10%..0%: stable_decline, > 0%: growing"
    },
    {
      "signal_type": "risk",
      "signal_subtype": "location_closure",
      "weight": 0.25,
      "description": "Lokasyon kapanışı sinyali (geçmişte ilan verilen şehirlerden birinin kaybolması)",
      "evidence": "current_month cities - historical_cities (pozitif = kapanış)",
      "scoring": [
        {
          "threshold": "2+ lokasyon kapanışı",
          "score": 0,
          "label": "multiple_closures"
        },
        {
          "threshold": "1 lokasyon kapanışı",
          "score": 25,
          "label": "single_closure"
        },
        {
          "threshold": "0 lokasyon kapanışı",
          "score": 100,
          "label": "no_closures"
        }
      ],
      "confidence_formula": "100 if >= 2 postings in closed city, else 70"
    },
    {
      "signal_type": "risk",
      "signal_subtype": "tech_team_halt",
      "weight": 0.2,
      "description": "Teknik ekip durması / hiring freeze sinyali (teknik/engineering ilanlarındaki düşüş)",
      "evidence": "current_tech_postings vs previous_tech_postings",
      "scoring": [
        {
          "threshold": ">= 50% tech ilan düşüşü",
          "score": 10,
          "label": "tech_freeze"
        },
        {
          "threshold": "20-49% tech ilan düşüşü",
          "score": 35,
          "label": "tech_slowdown"
        },
        {
          "threshold": "0-19% tech ilan düşüşü",
          "score": 65,
          "label": "tech_deceleration"
        },
        {
          "threshold": "tech ilanı artışı",
          "score": 100,
          "label": "tech_expansion"
        }
      ],
      "confidence_formula": "min(100, tech_count * 20 + 30) when tech_count > 0, else 50"
    },
    {
      "signal_type": "risk",
      "signal_subtype": "position_repetition",
      "weight": 0.2,
      "description": "Aynı pozisyon tekrarı sinyali (aynı rolü doldurulamama / turnover / kötü çalışma koşulları göstergesi)",
      "evidence": "repetition_count (aynı title + location kombinasyonunun aylık tekrar sayısı)",
      "scoring": [
        {
          "threshold": "5+ tekrar",
          "score": 0,
          "label": "high_repetition"
        },
        {
          "threshold": "3-4 tekrar",
          "score": 30,
          "label": "moderate_repetition"
        },
        {
          "threshold": "1-2 tekrar",
          "score": 65,
          "label": "low_repetition"
        },
        {
          "threshold": "0 tekrar",
          "score": 100,
          "label": "no_repetition"
        }
      ],
      "confidence_formula": "min(100, repetition_count * 15 + 20) when repetition_count > 0, else 100"
    }
  ],
  "weights_total": 1.0,
  "db_integration": {
    "company_signals_insert": {
      "signal_type": "risk",
