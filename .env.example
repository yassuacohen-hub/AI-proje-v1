# Huginn Data Insights - ornek environment dosyasi
# Gercek degerleri .env'e yazin (.env GIT'e ve Docker image'e girmez)

# Veritabani (Supabase pooler) — container'a env_file ile verilir
DATABASE_URL=postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres

# Dashboard API anahtari (bos/dev modu: herkese acik; prod'da set edin)
DASH_API_KEY=

# Yerel PostgreSQL (docker compose --profile localdb)
LOCAL_PG_PASSWORD=huginn_local_dev

# Legacy Telegram botu (opsiyonel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 9Router AI Gateway
# Uzaktan erişim (sunucu/cloud): tünel veya VPS adresi
#   NINEROUTER_URL=https://r3qmzpf.abc-tunnel.us/v1
# Lokal geliştirme (gateway bu bilgisayarda çalışıyorsa):
#   NINEROUTER_URL=http://localhost:20128
# İstemci sondaki "/v1" ekini otomatik temizler; hem base hem
# "/v1" ekli adres verilebilir (aksi halde /v1/v1/embeddings oluşurdu).
# Varsayılan (değer verilmezse): http://localhost:20128
NINEROUTER_URL=https://r3qmzpf.abc-tunnel.us
NINEROUTER_KEY=sk-...
NINEROUTER_MODEL=yasu-9router