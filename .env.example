# Huginn Data Insights — Environment Template
# Bu dosya repoya commit edilir. Asla .env dosyasını commit etmeyin.
# Kopyalayın: cp .env.example .env  (sonra gerçek değerleri doldurun)

# ============================================================
# API Anahtarları (Dummy değerler — gerçek değerleri .env'e yazın)
# ============================================================
GROQ_API_KEY=sk-dummy-groq-key-buraya-yazilacak
NINEROUTER_URL=https://api.ninerouter.example/v1
NINEROUTER_API_KEY=sk-dummy-ninerouter-key

# ============================================================
# Veritabanı Bağlantısı
# ============================================================
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/huginn

# ============================================================
# Admin / Güvenlik
# ============================================================
# Admin şifresi (gerçek değer .env'de, burada placeholder)
ADMIN_PASSWORD=***OKUNMAZ***
# Oturum gizli anahtarı (rastgele: python -c "import secrets; print(secrets.token_urlsafe(32))")
SESSION_SECRET=***GENERATE-RANDOM-32-CHARS***
# JWT imzalama anahtarı
JWT_SECRET=***GENERATE-RANDOM-32-CHARS***

# ============================================================
# Uygulama Ayarları
# ============================================================
# Debug modu (prod'da false)
DEBUG=false
# Log seviyesi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Debug modu (prod'da false)
DEBUG=false
# Log seviyesi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Uygulama portu (Huginn müşteri API)
HUGINN_PORT=8000
# Admin paneli portu (Muninn)
MUNINN_PORT=8501
# Crawl etkin: 0/1. Varsayılan 0.
CRAWL_ENABLED=0
# Uygulama portu (Huginn müşteri API)
HUGINN_PORT=8000
# Admin paneli portu (Muninn)
MUNINN_PORT=8501

# ============================================================
# Dış Servisler (Opsiyonel)
# ============================================================
# Redis (cache/queue için)
REDIS_URL=redis://localhost:6379/0
# Sentry DSN (hata takibi)
SENTRY_DSN=
# PagerDuty (alert için)
PAGERDUTY_INTEGRATION_KEY=

# ============================================================
# Vault / Secrets Yönetimi (Prod)
# ============================================================
# AWS Secrets Manager
AWS_SECRETS_MANAGER_REGION=eu-west-1
AWS_SECRETS_MANAGER_PREFIX=huginn/prod/
# HashiCorp Vault (alternatif)
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=
VAULT_PATH=secret/huginn/prod