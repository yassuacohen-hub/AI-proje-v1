# Huginn Data Insights - ornek environment dosyasi
# Gercek degerleri .env'e yazin (.env GIT'e ve Docker image'e girmez)

# Veritabani (Supabase pooler) — container'a env_file ile verilir
DATABASE_URL=postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres

# Dashboard API anahtari (bos/dev modu: herkese acik; prod'da set edin)
DASH_API_KEY=

# Yerel PostgreSQL (docker compose --profile localdb)
LOCAL_PG_PASSWORD=huginn_local_dev

# Telegram Bot (Product Owner 2026-09-01)
# Bot token: @BotFather'dan alinir. Asla kodda saklanmaz!
TELEGRAM_BOT_TOKEN=
# Yetkili chat ID (sadece bu kullaniciya bot komutlari gidebilir)
TELEGRAM_CHAT_ID=
# Ek yetkili chat ID'leri (virgulle ayri; opsiyonel)
TELEGRAM_ALLOWED_CHAT_IDS=
# Bot username (opsiyonel; /start@BotName komut parsing icin)
TELEGRAM_BOT_USERNAME=
# ETL restart komutu (opsiyonel; varsayilan: python scripts/refresh_pipeline.py)
ETL_RESTART_CMD=
# Periodik bot bildirim araligi (saniye, varsayilan 3600 = 1 saat)
TELEGRAM_PERIODIC_INTERVAL_SECONDS=3600
# Periodik bot aktif mi? (0 = devre-disi)
TELEGRAM_PERIODIC_ENABLED=1

# 9Router AI Gateway
# Uzaktan erişim (sunucu/cloud): tünel veya VPS adresi
#   NINEROUTER_URL=https://r3qmzpf.abc-tunnel.us/v1
# Lokal geliştirme (gateway bu bilgisayarda çalışıyorsa):
#   NINEROUTER_URL=http://localhost:20128
# İstemci sondaki "/v1" ekini otomatik temizler; hem base hem
# "/v1" ekli adres verilebilir (aksi halde /v1/v1/embeddings oluşurdu).
# Varsayılan (değer verilmezse): http://localhost:20128
NINEROUTER_URL=https://r3qmzpf.abc-tunnel.us
NINEROUTER_KEY=sk-...
NINEROUTER_MODEL=yasu-9router

# MIMIR (AI-CHAT-01, Muninn sohbet asistani) — model adlari YALNIZCA env ile izlenir.
# Virgullu fallback zinciri (ucuz/hizli once). Ilk canli test sonrasi sira/optimizasyon gerekebilir.
MIMIR_MODELS=gpt-4o-mini,gemini-2.0-flash,claude-3-5-haiku,yasu-9router
# Sohbet ici kilit sozu: teklif onayi bu sozcuk olmadan acilmaz (uretimde degistir).
MIMIR_KILIT_SOZU=abrakadabra

# Exa Search API (scripts/exa_arastir.py)
EXA_API_KEY=

# GitHub API (PR log okuma / anthropic_pr_review yerel calistirma). Fine-grained PAT: Contents read, Pull requests read, Actions read.
GH_TOKEN=

# Continue IDE (kaynak: docs/continue_config.yaml)
# Sahip testi 2026-09-17: Continue'da YALNIZ OpenRouter free modeller calisiyor.
# 9Router / Deepseek dogrudan / Anthropic dogrudan Continue'da CALISMIYOR.
# Anahtar: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Web arama MCP (@modelcontextprotocol/server-brave-search) — https://brave.com/search/api/
BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# API ANAHTAR ENVANTERI (test: python scripts/api_anahtar_testi.py)
# Anahtar ADLARI ASCII olmak ZORUNDA. Turkce "I" (U+0130) kullanilirsa
# os.getenv() anahtari BULAMAZ (ornek gecmis hata: ANTROPIC_API_KEY).
# Ayni ad iki kez yazilirsa parser SONUNCUYU alir; ilk satir olu kalir.
# ---------------------------------------------------------------------------

# LLM saglayicilari (dogrudan)
DEEPSEEK_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
KIMI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Gateway / yonlendirici
NINEROUTER_URL=
NINEROUTER_KEY=
NINEROUTER_MODEL=
KILO_GATEWAY_API_KEY=

# Arama / kazima / icerik
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Altyapi
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Apify (web scraping actor'lari: linkedin-company-jobs, website-crawler).
# Kod YALNIZ bu adi okur: APIFY_TOKEN (APIFY_API_TOKEN/APIFY_API_KEY kullanilmaz).
APIFY_TOKEN=
# Bazarlink: ucretsiz deneme anahtari "temsilci botu" uzerinden alinan
# talep baglantisi/token yapistirilarak aktiflesir (sahip notu 2026-09-17).
BAZARLINK_API_KEY=
BAZARLINK_API_URL=https://api.bazaarlink.ai/v1
