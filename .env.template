# ================================================================
# HUGINN DATA INSIGHTS - PRODUCTION ENVIRONMENT TEMPLATE
# Copy to .env and fill in ALL values before deployment
# NEVER commit .env to git! Add to .gitignore
# ================================================================

# ------------------------------------------------------------
# POSTGRESQL DATABASE
# ------------------------------------------------------------
POSTGRES_DB=hugin_commercial_db
POSTGRES_USER=hugin_admin
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS_MIN

# ------------------------------------------------------------
# REDIS CACHE
# ------------------------------------------------------------
# No password by default (internal network only)
# If enabling auth: REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://hugin-cache:6379/0
REDIS_PUBSUB_URL=redis://hugin-cache:6379/1

# ------------------------------------------------------------
# TOBB API CREDENTIALS (Provided by User)
# ------------------------------------------------------------
TOBB_API_URL=https://api.tobb.org.tr
TOBB_API_KEY=[REDACTED-ENV]
TOBB_API_SECRET=[REDACTED-ENV]
TOBB_CARD_02_COST_TL=19.49
TOBB_CARD_04_COST_TL=48.73
TOBB_PREPAID_MIN_BALANCE=50000

# ------------------------------------------------------------
# IYZICO PAYMENT GATEWAY (Escrow, Sub-merchant, Arbitration)
# ------------------------------------------------------------
IYZICO_API_KEY=CHANGE_ME_IYZICO_API_KEY
IYZICO_SECRET_KEY=CHANGE_ME_IYZICO_SECRET_KEY
IYZICO_BASE_URL=https://api.iyzipay.com
# Sandbox for testing: https://sandbox-api.iyzipay.com

# ------------------------------------------------------------
# OPENAI / LLM (PDF Parsing, AI Analysis, Quarantine Repair)
# ------------------------------------------------------------
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
OPENAI_MODEL_PARSER=gpt-4o-mini
OPENAI_MODEL_ANALYSIS=gpt-4o
OPENAI_MAX_TOKENS_PARSER=4000
OPENAI_MAX_TOKENS_ANALYSIS=8000

# ------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_64_CHARS_MIN
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ------------------------------------------------------------
# CORS ORIGINS (Production Domains)
# ------------------------------------------------------------
CORS_ORIGINS=https://app.huginn.local,https://admin.huginn.local,https://api.huginn.local

# ------------------------------------------------------------
# LOGGING & MONITORING
# ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=production

# ------------------------------------------------------------
# KONG GATEWAY
# ------------------------------------------------------------
KONG_LOG_LEVEL=notice
# Certificate paths (mounted from ./kong/certs)
KONG_SSL_CERT_PATH=/usr/local/kong/certs/kong-server.pem
KONG_SSL_KEY_PATH=/usr/local/kong/certs/kong-server.key
KONG_CA_CERT_PATH=/usr/local/kong/certs/ca.pem

# ------------------------------------------------------------
# WORKER CONFIGURATION
# ------------------------------------------------------------
WORKER_CONCURRENCY_TOBB=4
WORKER_CONCURRENCY_PDF=2
WORKER_CONCURRENCY_QUARANTINE=2
QUARANTINE_BATCH_SIZE=50
QUARANTINE_INTERVAL_SECONDS=60
WORKER_PREFETCH_MULTIPLIER=1

# ------------------------------------------------------------
# FRONTEND (Next.js)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.huginn.local
NEXT_PUBLIC_WS_URL=wss://api.huginn.local
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ------------------------------------------------------------
# ADMIN PANEL (Streamlit)
# ------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# ------------------------------------------------------------
# CHROMADB VECTOR STORE
# ------------------------------------------------------------
CHROMA_SERVER_HOST=0.0.0.0
CHROMA_SERVER_HTTP_PORT=8000
ANONYMIZED_TELEMETRY=false
ALLOW_RESET=true

# ------------------------------------------------------------
# MONITORING (Prometheus/Grafana)
# ------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# Generate with: openssl rand -base64 32
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ------------------------------------------------------------
# FINANCIAL MODEL PARAMETERS
# ------------------------------------------------------------
USD_RATE=50.0
KDV_RATE=0.20
CORPORATE_TAX_RATE=0.25
IYZICO_COMMISSION=0.035
IYZICO_FIXED_FEE=0.50
TOBB_API_COST_USD=0.60
AI_TOKEN_COST_USD_PER_QUERY=0.10

# Credit pricing (TL)
CREDIT_PRICE_TL=50.0
CREDIT_DEEP_REPORT=3
CREDIT_WEBHOOK_SIGNAL=3
CREDIT_FINDEKS_CHECK=1

# Enterprise pricing
ENTERPRISE_API_YEARLY_TL=650000
ENTERPRISE_API_MONTHLY_TL=60000

# ------------------------------------------------------------
# SECURITY SETTINGS
# ------------------------------------------------------------
# AES-256 Encryption Key for sensitive data at rest
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_32_BYTES

# Rate limiting
RATE_LIMIT_PUBLIC_PER_MINUTE=100
RATE_LIMIT_ENTERPRISE_PER_MINUTE=1000
RATE_LIMIT_ADMIN_PER_MINUTE=50

# Session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict

# ------------------------------------------------------------
# KVKK / COMPLIANCE
# ------------------------------------------------------------
DATA_RETENTION_DAYS=2555  # 7 years
PII_MASKING_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555

# ------------------------------------------------------------
# BACKUP & DISASTER RECOVERY
# ------------------------------------------------------------
BACKUP_SCHEDULE_CRON=0 2 * * *  # Daily at 02:00
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=hugin-backups-prod
BACKUP_S3_REGION=eu-central-1
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BACKUP_ENCRYPTION_KEY

# ------------------------------------------------------------
# EXTERNAL SCRAPING / PROXY (IP-1 Only)
# ------------------------------------------------------------
# Use residential proxies for scraping to keep server IPs clean
SCRAPING_PROXY_URL=http://proxy-provider:port
SCRAPING_PROXY_USERNAME=CHANGE_ME_PROXY_USER
SCRAPING_PROXY_PASSWORD=CHANGE_ME_PROXY_PASS
SCRAPING_USER_AGENT_ROTATION=true

# ------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------
FEATURE_MIRMIR_LIVE_STREAM=true
FEATURE_QUARANTINE_AUTO_REPAIR=true
FEATURE_ESCROW_ARBITRATION=true
FEATURE_ENTERPRISE_API=true
FEATURE_WEBHOOK_SALES=true
FEATURE_FINDEKS_PLG_HOOK=true
FEATURE_PDF_GAZETTE_PARSING=true

# ------------------------------------------------------------
# NETWORK ADDRESSES (Update for your VDS)
# ------------------------------------------------------------
# Physical IP addresses on Windows Server 2022
HOST_IP_PUBLIC=192.168.1.50
HOST_IP_ENTERPRISE=192.168.1.60

# Docker network subnet (must match docker-compose.yml)
DOCKER_SUBNET=172.16.0.0/12

# ================================================================
# GENERATION HELPERS (Run these commands to generate secure values):
# ================================================================
# POSTGRES_PASSWORD:     openssl rand -base64 32
# JWT_SECRET_KEY:        openssl rand -base64 64
# ENCRYPTION_KEY:        openssl rand -base64 32
# GRAFANA_ADMIN_PASSWORD: openssl rand -base64 32
# BACKUP_ENCRYPTION_KEY: openssl rand -base64 32
# ================================================================