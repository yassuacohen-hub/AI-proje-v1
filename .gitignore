.env

# Veritabanı yedekleri (Supabase pg_dump ciktilari)
backups/

# Obsidian vault (AI proje v1) — pinli submodule olarak takip ediliyor (bkz. .gitmodules).
# İçerik ana repoya girmez; yalnızca gitlink (commit hash) versionlanır.
# Vault içindeki .env vb. hassas dosyalar vault'un kendi .gitignore'unda dışlanır.

# Ortam ve gizli bilgiler
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
test_reports/
.ruff_cache/
.mypy_cache/
.coverage
coverage.json
htmlcov/

# Sanal ortamlar
.venv/
.venv_test/

# Veritabanı dosyaları (yerel/legacy fallback; asıl veritabanı Supabase/PostgreSQL)
*.db
*.db-journal

# Loglar (yeniden üretilebilir çalışma zamanı çıktıları)
logs/
*.log

# Geçici/deneme dosyaları — bkz. AGENTS.md "Çöp Kutusu (Trash) Kuralı"
_trash/
tmp/

# V10 içeriklerini engelle (şikayet raporları, eski belgeler, vb.)
V10/

# ORCH-GIT-01 (KAHİN kararı 2026-09-18): orkestrator pano + karar defteri + rapor/bulgu
# arşivi git'te TUTULUR. Gerekçe: yedek kritik; süreç/karar yönetimi ileride ayrı ürüne
# çıkabilir. Yalnız makineye özgü runtime artıkları dışlanır.
data/orchestrator/nobetci.pid
data/orchestrator/file_locks.json
data/orchestrator/state.json
data/orchestrator/change_notify_state.json
data/orchestrator/_*.txt
data/orchestrator/_*.py
data/orchestrator/task_board_corrupt_backup.json
# D-186: pano dosyaları runtime state (state.json gibi); repodan çıkarıldı split riski nedeniyle
data/orchestrator/task_board.json
data/orchestrator/onay_kuyrugu.json
data_worktree/orchestrator/task_board.json
data_worktree/orchestrator/onay_kuyrugu.json
# D-186: otomatik zaman damgali yedekler ve yedek klasorleri repoya girmez
data/orchestrator/*.bak
data_worktree/orchestrator/*.bak
data/orchestrator/_yedek_*/
data_worktree/orchestrator/_yedek_*/
# D-58: orkestrator devralma anahtari (gizli, repoya girmez)
data/orchestrator/abrakadabra.key

# Araç/repair dosyalari (scripts dizinine ozgu)
scripts/check_*.py
scripts/fix_*.py
# ADMIN-KOK-TEMIZLIK-01: kok dizine gecici duzeltme scripti birakilmaz
