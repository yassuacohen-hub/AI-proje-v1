.env

# Veritabanı yedekleri (Supabase pg_dump ciktilari)
backups/

# Gömülü/ayrı git deposu (kendi GitHub remote'u var: AI-proje-v1)
# Nested git repo olarak eklenmez; gitlink sorunlarını önlemek için dışlandı.
AI proje v1/

# Ortam ve gizli bilgiler
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.coverage
coverage.json
htmlcov/

# Sanal ortamlar
.venv/
.venv_test/

# Veritabanı dosyaları (yerel/legacy fallback; asıl veritabanı Supabase/PostgreSQL)
*.db
*.db-journal

# Loglar (yeniden üretilebilir çalışma zamanı çıktıları)
logs/
*.log

# Geçici/deneme dosyaları — bkz. AGENTS.md "Çöp Kutusu (Trash) Kuralı"
_trash/
tmp/

# V10 içeriklerini engelle (şikayet raporları, eski belgeler, vb.)
V10/

# Araç/repair dosyalari (scripts dizinine ozgu)
data/orchestrator/task_board_corrupt_backup.json
data/orchestrator/
