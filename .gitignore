scripts/inspect_*.py
scripts/validate_*.py
scripts/final_validate.py
scripts/check_wiki_counts.py
scripts/examine_json.py
scripts/find_*.py

# Node.js
node_modules/
package-lock.json

# Obsidian kişisel/yerel çalışma alanı durumu (workspace paylaşılmaz, plugin listesi paylaşılır)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Playwright MCP çıktıları
.playwright-mcp/

# Diğer araç/skill yerel klasörleri (makine bazlı, proje kodu değil)
