+def _registrable_domain(host: str) -> str:
+    """Subdomain-aware kontrol icin: m.facebook.com -> facebook.com."""
+    if not host:
+        return ""
+    parts = host.lower().split(".")
+    if len(parts) <= 2:
+        return host.lower()
+    # 2-harflik TLD'ler (com.tr, co.uk vb.) icin son 3 segment
+    two_level_tlds = {"com.tr", "co.uk", "org.uk", "net.tr", "edu.tr", "gov.tr"}
+    last_two = ".".join(parts[-2:])
+    if last_two in two_level_tlds and len(parts) >= 3:
+        return ".".join(parts[-3:]).lower()
+    return ".".join(parts[-2:]).lower()
+
+
+def _is_blocked(url: str) -> bool:
+    """Subdomain-aware blocklist kontrolu."""
+    try:
+        host = urlparse(url).netloc or urlparse(url).path
+    except Exception:
+        return True
+    if not host:
+        return True
+    reg = _registrable_domain(host)
+    host_lower = host.lower()
+    for blocked in WEB_BLOCKLIST:
+        if blocked in host_lower or blocked == reg:
+            return True
+    return False
+
