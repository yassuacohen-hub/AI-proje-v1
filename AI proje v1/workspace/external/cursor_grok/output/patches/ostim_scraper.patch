+def _find_detail_block_table(soup: BeautifulSoup, field_key: str) -> str | None:
+    """<table class="firma-detay"> satirlarinda th/td bazli arama."""
+    labels = DETAY_LABEL_MAP[field_key]
+    for table in soup.select("table.firma-detay"):
+        for row in table.find_all("tr"):
+            th = row.find("th")
+            td = row.find("td")
+            if not th or not td:
+                continue
+            th_text = th.get_text(" ", strip=True).lower().strip(" :")
+            if not th_text:
+                continue
+            if any(th_text == lab or th_text.startswith(lab + ":") or th_text.startswith(lab + " ") for lab in labels):
+                value = td.get_text(" ", strip=True)
+                value = re.sub(r"\s+", " ", value).strip(" :")
+                if value and len(value) >= 1 and value != "-":
+                    return value
+    return None
+
+
+def _find_detail_block_dl(soup: BeautifulSoup, field_key: str) -> str | None:
+    """<dl class="firma-detay"> definition list bazli arama."""
+    labels = DETAY_LABEL_MAP[field_key]
+    for dl in soup.select("dl.firma-detay, dl"):
+        dts = dl.find_all("dt")
+        dds = dl.find_all("dd")
+        for dt, dd in zip(dts, dds):
+            dt_text = dt.get_text(" ", strip=True).lower().strip(" :")
+            if any(dt_text == lab or dt_text.startswith(lab + ":") or dt_text.startswith(lab + " ") for lab in labels):
+                value = dd.get_text(" ", strip=True)
+                value = re.sub(r"\s+", " ", value).strip(" :")
+                if value and len(value) >= 1 and value != "-":
+                    return value
+    return None
+
+
+def _find_detail_universal(soup: BeautifulSoup, field_key: str) -> str | None:
+    """Sira: table > dl > sibling-scan (eski davranis)."""
+    val = _find_detail_block_table(soup, field_key)
+    if val:
+        return val
+    val = _find_detail_block_dl(soup, field_key)
+    if val:
+        return val
+    return _find_detail_block(soup, field_key)
+
