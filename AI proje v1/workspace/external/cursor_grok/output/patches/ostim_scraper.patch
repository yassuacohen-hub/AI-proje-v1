+def _normalize_vergi_no(raw: str | None) -> str | None:
+    """VKN normalize: nokta/space/tab temizligi, maskelenmis -> None, 10 veya 11 hane."""
+    if not raw:
+        return None
+    s = str(raw).strip()
+    if not s:
+        return None
+    # maskelenmis: "***", "**********"
+    if set(s.replace(" ", "")) <= {"*"}:
+        return None
+    # sadece rakam kalacak sekilde temizle
+    s = re.sub(r"[^\d]", "", s)
+    if not s:
+        return None
+    if len(s) not in (10, 11):
+        return None
+    return s
 
 
