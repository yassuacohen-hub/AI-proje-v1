+def _http_get_with_retry(url: str) -> requests.Response | None:
+    """Retry/backoff ile GET. None donerse 4xx/5xx/network error."""
+    last_exc: Exception | None = None
+    delays = (0.0,) + RETRY_BACKOFF
+    for delay in delays:
+        if delay:
+            time.sleep(delay)
+        try:
+            resp = requests.get(
+                url, headers={"User-Agent": USER_AGENT}, timeout=REQUEST_TIMEOUT
+            )
+            if resp.status_code >= 400:
+                log.warning("HTTP %s for %s", resp.status_code, url)
+                return resp if resp.status_code < 500 else None
+            return resp
+        except requests.RequestException as exc:
+            last_exc = exc
+            log.warning("Network error %s: %s", url, exc)
+    log.error("Tum denemeler basarisiz %s: %s", url, last_exc)
+    return None
+
